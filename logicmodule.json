{
  "name": "Proxmox_VE",
  "version": "1.0.0",
  "transport": "HTTPS JSON API",
  "appliesTo": "getPropValue(\"pve.monitor\") && pve.monitor == \"true\"",
  "execution": "Embedded Groovy; no script arguments are supplied automatically",
  "datasources": [
    {"name":"Proxmox_VE_Cluster","resourceLabel":"Cluster","collectionScript":"scripts/Proxmox_VE_Cluster_CT.groovy","collectionArguments":["cluster"],"activeDiscovery":false,"datapoints":["quorate","votes","expectedVotes"]},
    {"name":"Proxmox_VE_Node","resourceLabel":"Nodes","activeDiscoveryScript":"scripts/Proxmox_VE_Node_AD.groovy","activeDiscoveryArguments":["node","discover"],"collectionScript":"scripts/Proxmox_VE_Node_CT.groovy","collectionArguments":["node"],"datapoints":["up","cpuPct","load1","memUsedPct","memUsedBytes","memTotalBytes","swapUsedPct","rootUsedPct","rootUsedBytes","rootTotalBytes","uptimeSeconds","netInBytes","netOutBytes"]},
    {"name":"Proxmox_VE_Guest","resourceLabel":"Guests","activeDiscoveryScript":"scripts/Proxmox_VE_Guest_AD.groovy","activeDiscoveryArguments":["guest","discover"],"collectionScript":"scripts/Proxmox_VE_Guest_CT.groovy","collectionArguments":["guest"],"datapoints":["up","status","cpuPct","memUsedPct","memUsedBytes","memMaxBytes","diskUsedBytes","diskMaxBytes","netInBytes","netOutBytes","uptimeSeconds"]},
    {"name":"Proxmox_VE_Storage","resourceLabel":"Storage","activeDiscoveryScript":"scripts/Proxmox_VE_Storage_AD.groovy","activeDiscoveryArguments":["storage","discover"],"collectionScript":"scripts/Proxmox_VE_Storage_CT.groovy","collectionArguments":["storage"],"datapoints":["up","usedBytes","availableBytes","totalBytes","usedPct"]}
  ]
}
